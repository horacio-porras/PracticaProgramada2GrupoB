@model PracticaProgramada2BLL.Dtos.ProductoDto;

<div class="modal fade" id="modalEditarProducto" tabindex="-1" aria-labelledby="modalEditarProductoLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalEditarProductoLabel">Editar Producto</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="formEditarProducto" asp-action="ActualizarProducto" asp-controller="Producto">
                    <input type="hidden" asp-for="Id" id="ProductoId" name="Id" />
                    <div class="mb-3">
                        <label for="NombreEdit" class="form-label">Nombre</label>
                        <input type="text" class="form-control" id="NombreEdit" name="Nombre" required />
                    </div>
                    <div class="mb-3">
                        <label for="DescripcionEdit" class="form-label">Descripción</label>
                        <input type="text" class="form-control" id="DescripcionEdit" name="Descripcion" />
                    </div>
                    <div class="mb-3">
                        <label for="PrecioEdit" class="form-label">Precio</label>
                        <input type="number" step="0.01" class="form-control" id="PrecioEdit" name="Precio" />
                    </div>
                    <div class="mb-3">
                        <label for="StockEdit" class="form-label">Stock</label>
                        <input type="number" class="form-control" id="StockEdit" name="Stock" />
                    </div>
                    <div class="mb-3">
                        <label for="CategoriaIdEdit" class="form-label">Categoría</label>
                        <select class="form-select" id="CategoriaIdEdit" name="CategoriaId" required>
                            <option value="">-- Seleccione categoría --</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-primary" id="btnEditarProducto">Editar Producto</button>
            </div>
        </div>
    </div>
</div>
